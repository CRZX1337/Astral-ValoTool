<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The Web SDK defaults to a console subsystem, which pops a terminal
         next to the desktop window. -->
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <ApplicationIcon>images\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Which native WebView2 loader to ship. Follows the publish RID so an
       arm64 build cannot silently walk away with the x64 loader; a plain
       `dotnet build` sets no RID, and win-x64 is the one we release. -->
  <PropertyGroup>
    <WebView2LoaderRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</WebView2LoaderRid>
    <WebView2LoaderRid Condition="'$(WebView2LoaderRid)' == ''">win-x64</WebView2LoaderRid>
  </PropertyGroup>

  <!-- Identity baked into the Win32 version resource: this is what the file's
       Properties dialog, Task Manager and SmartScreen prompts show, so a
       downloaded release does not look anonymous.

       <Version> is also what the updater compares against the newest GitHub
       release tag (UpdateService.ResolveCurrentVersion reads it back off the
       assembly), so it has to be bumped in the same commit that gets tagged.
       A build that under-reports its version offers itself an update forever. -->
  <PropertyGroup>
    <Version>1.3.0</Version>
    <Product>Astral</Product>
    <AssemblyTitle>Astral - VALORANT multitool</AssemblyTitle>
    <Description>Instalocks your chosen agent with a fallback chain, reads the pre-game lobby, tracks rank across a session, and updates itself from GitHub releases.</Description>
    <Authors>CRZX1337</Authors>
    <Company>CRZX1337</Company>
    <Copyright>MIT licensed. Copyright (c) 2026 CRZX1337.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="RadiantConnect" Version="10.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_upstream_instalocker\**" />
    <Compile Remove="_upstream_radiantconnect\**" />
    <Content Remove="_upstream_instalocker\**" />
    <Content Remove="_upstream_radiantconnect\**" />
    <Content Remove="wwwroot\**\*" />
    <!-- The GitHub Pages site. The Web SDK's default globs would otherwise
         sweep its files into the published app. -->
    <Content Remove="docs\**" />
    <None Remove="docs\**" />
    <EmbeddedResource Remove="_upstream_instalocker\**" />
    <EmbeddedResource Remove="_upstream_radiantconnect\**" />
    <None Remove="_upstream_instalocker\**" />
    <None Remove="_upstream_radiantconnect\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <!-- Also embedded so the window icon survives a single-file publish. -->
    <EmbeddedResource Include="images\app.ico" LogicalName="Astral.app.ico" />
    <Content Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\$(WebView2LoaderRid)\native\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
